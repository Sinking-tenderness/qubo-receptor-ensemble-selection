{
  "schema_version": "1.0",
  "experiment_id": "stage26-variable-budget-consensus-qubo-20260802-v1",
  "purpose": "Test a frozen non-submodular, variable-cardinality structural consensus QUBO across three proteins and increasing candidate-pool sizes before any functional docking or hardware execution.",
  "evidence_timing": {
