  },
  "objective": {
    "maximum_selected": 8,
    "neighborhood_fraction": 0.10,
    "single_coverage_weight": 0.25,
    "double_coverage_weight": 0.75,
    "pair_diversity_weight": 0.10,
    "per_conformer_cost": 0.04,
    "budget_constraint_penalty": 20.0,
    "coverage_constraint_penalty": 100.0,
    "interpretation": "A structural state earns 0.25 after one representative and the remaining 0.75 only after a second independent representative; the increasing second-hit marginal creates genuine complementarity and removes the usual submodular-coverage guarantee for greedy selection."
  },
  "instances": {
    "nested_order": "reference_first_then_sha256_of_target_and_conformer_id",
    "small_exact_oracle_size": 16,
    "exact_oracle_state_limit": 1000000
  },
  "classical_baselines": {
    "methods": ["direct_greedy_plus_variable_local_search", "beam_plus_variable_local_search"],
    "beam_widths": [128, 512]
  },
  "sampler": {
    "batch_count": 3,
    "reads_per_batch": 32,
    "sweeps_per_read": 2000,
    "temperature_start": 0.04,
    "temperature_end": 0.0002,
    "base_seed": 20260826,
    "initialization": "uniform_random_cardinality_from_zero_to_maximum_selected",
    "moves": ["add", "remove", "swap"]
  },
  "gate": {
    "objective_tolerance": 0.0001,
    "minimum_full_instance_batch_fraction_within_tolerance": 0.75,
    "minimum_full_targets_strictly_above_strong_classical": 2,
    "minimum_gain_vs_strong_classical": 1e-9,
    "maximum_small_instance_gap_to_exact": 0.0001,
    "direct_qpu_max_variables": 200,
    "direct_qpu_max_coefficient_dynamic_range": 100.0
  },
  "outputs": {
