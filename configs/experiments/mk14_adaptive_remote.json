{
  "schema_version": "3.0",
  "experiment_id": "mk14-adaptive-remote",
  "target_id": "MK14",
  "workflow_mode": "full",
  "pipeline": [
    "prepare",
    "dock",
    "aggregate",
    "build_problem",
    "solve",
    "evaluate",
    "persist"
  ],
  "start_stage": "prepare",
  "end_stage": "persist",
  "selection": {
    "receptor_count": 15,
    "ligand_count": 600,
    "label_counts": {
      "active": 120,
      "decoy": 480
    },
    "ordering": "scaffold_hash_allocation",
    "allocation": {
      "hash_namespace": "STAGE102A",
      "outer_fold_count": 5,
      "minimum_label_counts_per_outer_fold": {
        "active": 20,
        "decoy": 80
      }
    }
  },
  "sources": {
    "active_ism": "data/raw/dude/mk14/actives_final.ism",
    "decoy_ism": "data/raw/dude/mk14/decoys_final.ism",
    "reference_receptor_pdb": "data/raw/external_targets/mk14_dude/mk14/receptor.pdb",
    "crystal_ligand": "data/raw/external_targets/mk14_dude/mk14/crystal_ligand.sdf",
    "rcsb_directory": "data/raw/rcsb/mk14"
  },
  "receptor_preparation": {
    "reference_chain": "auto",
    "mobile_chain": "auto",
    "minimum_alignment_ca_count": 50,
    "allow_bad_res": true
  },
  "preparation": {
    "workers": 4,
    "base_seed": 20260818
  },
  "docking": {
    "redock": true,
    "engine": "unidock",
    "executable": "unidock",
    "seeds": [
      20260821,
      20260822,
      20260823
    ],
    "box": {
      "method": "ligand_bounds",
      "padding": 5.0,
      "minimum_size": [
        22.0,
        22.0,
        28.0
      ]
    },
    "parameters": {
      "scoring": "vina",
      "exhaustiveness": 1024,
      "max_step": 80,
      "refine_step": 5,
      "num_modes": 1,
      "energy_range": 3,
      "verbosity": 1
    }
  },
  "problem": {
    "type": "receptor_subset",
    "strategy": "qubo",
    "target_size": 1,
    "utility_metric": "bedroc",
    "bedroc_alpha": 20.0,
    "utility_normalization": "none",
    "weights": {
      "redundancy": 0.25,
      "count": 0.1,
      "size": 10.0
    },
    "k_policy": {
      "mode": "adaptive",
      "selector": "mechanistic_bootstrap_lcb",
      "candidates": [1, 2, 3],
      "scaffold_field": "scaffold_smiles",
      "inner_fold_count": 3,
      "bootstrap_iterations": 1000,
      "lower_quantile": 0.05,
      "minimum_effect": 0.0,
      "rescue_fractions": [0.01, 0.05],
      "random_seed": 0
    }
  },
  "solve": {
    "backend": "exact"
  },
  "evaluate": {
    "aggregation": "mean_score",
    "primary_metric": "bedroc_alpha_20",
    "metrics": [
      "bedroc_alpha_20",
      "roc_auc",
      "pr_auc_average_precision",
      "EF1%",
      "EF5%",
      "EF10%"
    ]
  },
  "paths": {
    "run_directory": "results/runs/mk14_adaptive_remote",
    "prepared_ligand_manifest": "results/runs/mk14_adaptive_remote/prepared_ligands.csv",
    "selected_receptor_manifest": "results/runs/mk14_adaptive_remote/selected_receptors.csv",
    "docking_box": "results/runs/mk14_adaptive_remote/docking_box.json",
    "score_tables": "results/runs/mk14_adaptive_remote/score_tables",
    "matrices": "results/runs/mk14_adaptive_remote/matrices",
    "primary_matrix": "results/runs/mk14_adaptive_remote/matrices/primary_median_matrix.csv",
    "problem": "results/runs/mk14_adaptive_remote/problem.json",
    "selection": "results/runs/mk14_adaptive_remote/selection.json",
    "evaluation": "results/runs/mk14_adaptive_remote/evaluation.json"
  }
}
