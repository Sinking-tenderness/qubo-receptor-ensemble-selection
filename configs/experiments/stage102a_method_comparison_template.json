{
  "schema_version": "3.0",
  "experiment_id": "stage102a-method-comparison-template",
  "target_id": "EGFR",
  "workflow_mode": "reference_replay",
  "pipeline": [
    "prepare",
    "dock",
    "aggregate",
    "build_problem",
    "solve",
    "evaluate",
    "persist"
  ],
  "start_stage": "build_problem",
  "end_stage": "persist",
  "selection": {
    "receptor_count": 12,
    "ligand_count": 600,
    "label_counts": {
      "active": 120,
      "decoy": 480
    },
    "ordering": "scaffold_hash_allocation",
    "allocation": {
      "hash_namespace": "STAGE102A",
      "outer_fold_count": 5,
      "minimum_label_counts_per_outer_fold": {
        "active": 20,
        "decoy": 80
      }
    }
  },
  "sources": {
    "active_ism": "data/raw/external_targets/egfr_dude/egfr/actives_final.ism",
    "decoy_ism": "data/raw/external_targets/egfr_dude/egfr/decoys_final.ism",
    "reference_receptor_pdb": "data/raw/external_targets/egfr_dude/egfr/receptor.pdb",
    "crystal_ligand": "data/raw/external_targets/egfr_dude/egfr/crystal_ligand.mol2",
    "rcsb_directory": "data/raw/rcsb/egfr"
  },
  "receptor_preparation": {
    "reference_chain": "auto",
    "mobile_chain": "auto",
    "minimum_alignment_ca_count": 50,
    "allow_bad_res": true
  },
  "preparation": {
    "workers": 4,
    "base_seed": 20260818
  },
  "docking": {
    "redock": false,
    "engine": "unidock",
    "executable": "unidock",
    "seeds": [20260821, 20260822, 20260823],
    "box": {
      "method": "ligand_bounds",
      "padding": 5.0,
      "minimum_size": [22.0, 22.0, 30.0]
    },
    "parameters": {
      "scoring": "vina",
      "exhaustiveness": 1024,
      "max_step": 80,
      "refine_step": 5,
      "num_modes": 1,
      "energy_range": 3,
      "verbosity": 1
    }
  },
  "problem": {
    "type": "receptor_subset",
    "mode": "compare",
    "target_size": 3,
    "utility_metric": "bedroc",
    "bedroc_alpha": 20.0,
    "weights": {
      "redundancy": 0.25,
      "count": 0.1,
      "size": 10.0
    },
    "methods": [
      {"id": "basic_utility"},
      {"id": "pair_utility"},
      {"id": "pair_synergy"},
      {"id": "bedroc20_pair_synergy", "decoy_penalty_lambda": 1.5},
      {"id": "rank_sensitive_pair"},
      {"id": "normalized_coverage"},
      {"id": "auxiliary_coverage"},
      {"id": "rankbin_bedroc20", "bin_count": 32},
      {"id": "structure_aware"},
      {"id": "signed_hubo"}
    ]
  },
  "solve": {
    "backend": "exact"
  },
  "evaluate": {
    "aggregation": "mean_score",
    "primary_metric": "bedroc_alpha_20",
    "metrics": [
      "bedroc_alpha_20",
      "roc_auc",
      "pr_auc_average_precision",
      "EF1%",
      "EF5%",
      "EF10%"
    ]
  },
  "paths": {
    "run_directory": "results/runs/stage102a_method_comparison_template",
    "prepared_ligand_manifest": "results/runs/stage102a_egfr_full_local/prepared_ligands.csv",
    "selected_receptor_manifest": "results/runs/stage102a_egfr_full_local/selected_receptors.csv",
    "docking_box": "results/runs/stage102a_egfr_full_local/docking_box.json",
    "score_tables": "results/runs/stage102a_egfr_full_local/score_tables",
    "matrices": "results/runs/stage102a_egfr_full_local/matrices",
    "primary_matrix": "results/runs/stage102a_egfr_full_local/matrices/primary_median_matrix.csv",
    "problem": "results/runs/stage102a_method_comparison_template/problem.json",
    "selection": "results/runs/stage102a_method_comparison_template/selection.json",
    "evaluation": "results/runs/stage102a_method_comparison_template/evaluation.json"
  }
}
