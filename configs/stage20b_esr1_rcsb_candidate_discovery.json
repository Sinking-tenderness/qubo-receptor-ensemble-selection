  "discovery_rules": {
    "experimental_method": "X-RAY DIFFRACTION",
    "minimum_metadata_eligible_count": 24,
    "metadata_eligibility": {
      "required_mutation_count": 0,
      "maximum_resolution_angstrom": 2.5,
      "minimum_reference_sequence_coverage": 0.35,
      "minimum_sample_sequence_length": 220,
      "maximum_sample_sequence_length": 310,
      "require_same_chain_drug_like_nonpolymer": true,
      "minimum_nonpolymer_formula_weight_kda": 0.15,
      "maximum_nonpolymer_formula_weight_kda": 0.9,
      "excluded_nonpolymer_ids": ["ACT", "ADP", "AMP", "ATP", "BME", "CA", "CD", "CIT", "CL", "CO", "DMS", "EDO", "FLC", "GOL", "K", "MES", "MG", "MN", "MPD", "NA", "NI", "PEG", "PG4", "PGE", "PO4", "SO4", "TRS", "ZN"],
      "excluded_title_patterns": ["\\bapo\\b", "unliganded", "covalent", "irreversible", "mutant", "mutation"]
    },
    "domain_rule_rationale": "ESR1 X-ray structures resolve the approximately 250-residue ligand-binding domain. Requiring 0.50 coverage of the 595-residue full-length UniProt sequence would incorrectly exclude the wild-type 1SJ0 DUD-E reference."
  },
  "rcsb": {
    "search_endpoint": "https://search.rcsb.org/rcsbsearch/v2/query",
    "graphql_endpoint": "https://data.rcsb.org/graphql",
    "metadata_chunk_size": 40,
    "request_timeout_seconds": 60,
    "maximum_retries": 4,
    "retry_backoff_seconds": 1.0
  },
